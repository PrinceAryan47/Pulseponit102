// ===============================================================
// PulsePoint Hardened Firestore Security Rules
// Zero-Trust Role-Based Access Control & Patient Privacy
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Super Administrator: strictly requires email verification from authorized admin accounts
    function isSuperAdmin() {
      return isAuthenticated() && 
             request.auth.token.email in ["mafialord1247@gmail.com", "mafia.lord1247@gmail.com", "kyleisrael44@gmail.com", "prince47aryan@gmail.com"] &&
             request.auth.token.email_verified == true;
    }

    // Approved Doctor verification: requires valid role, status approved, and active license
    function isDoctor() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated() && exists(path) && 
             get(path).data.role == 'doctor' && 
             get(path).data.get('status', 'pending') == 'approved' &&
             get(path).data.get('licenseVerificationStatus', 'pending') == 'verified';
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'fullName']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['patient', 'doctor', 'admin'] &&
             data.fullName is string && data.fullName.size() <= 120 &&
             (!('gender' in data) || data.gender is string) &&
             (!('phoneNumber' in data) || data.phoneNumber is string) &&
             (!('isOnline' in data) || data.isOnline is bool) &&
             (!('lastSeen' in data) || data.lastSeen is timestamp || data.lastSeen is string) &&
             (!('licenseNumber' in data) || data.licenseNumber is string) &&
             (!('licenseDocumentUrl' in data) || data.licenseDocumentUrl is string) &&
             (!('licenseDocumentName' in data) || data.licenseDocumentName is string) &&
             (!('verificationResult' in data) || data.verificationResult is map) &&
             (!('photoURL' in data) || data.photoURL is string) &&
             (!('specialization' in data) || data.specialization is string) &&
             (!('hospitalId' in data) || data.hospitalId is string) &&
             (!('hospitalName' in data) || data.hospitalName is string) &&
             (!('status' in data) || data.status in ['pending', 'approved', 'rejected']) &&
             (!('licenseVerificationStatus' in data) || data.licenseVerificationStatus in ['pending', 'verified', 'rejected']) &&
             (!('hospitalApprovalStatus' in data) || data.hospitalApprovalStatus in ['pending', 'approved', 'rejected']) &&
             (!('simulatedLocationEnabled' in data) || data.simulatedLocationEnabled is bool) &&
             (!('simulatedLocationPreset' in data) || data.simulatedLocationPreset is string) &&
             (!('simulatedLatitude' in data) || data.simulatedLatitude is number) &&
             (!('simulatedLongitude' in data) || data.simulatedLongitude is number) &&
             (!('preferredCity' in data) || data.preferredCity is string) &&
             (!('preferredCountry' in data) || data.preferredCountry is string) &&
             (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is string);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['roomId', 'text', 'senderId']) &&
             data.roomId is string && data.roomId.size() <= 256 &&
             data.text is string && data.text.size() <= 50000 &&
             data.senderId == request.auth.uid;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 2000;
    }

    // ===============================================================
    // Collection Match Rules
    // ===============================================================

    // Email Registry: No public scraping. Only admins can read, user can register their own
    match /emails/{email} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.get('uid', '');
      allow update, delete: if isSuperAdmin();
    }

    // User Profiles: Private patient isolation & public approved doctor directory
    match /users/{userId} {
      allow get: if isAuthenticated() && (
        isOwner(userId) || 
        (resource.data.role == 'doctor' && resource.data.get('status', '') == 'approved') || 
        isSuperAdmin() ||
        (isDoctor() && (
          exists(/databases/$(database)/documents/accessRequests/$(userId + "_" + request.auth.uid)) && 
          get(/databases/$(database)/documents/accessRequests/$(userId + "_" + request.auth.uid)).data.status == 'approved'
        ))
      );
      
      allow list: if isAuthenticated() && (
        isOwner(userId) || 
        (resource.data.role == 'doctor' && resource.data.get('status', '') == 'approved') || 
        isSuperAdmin()
      );
      
      // Forbid privilege escalation to admin; require pending status for all doctor registrations
      allow create: if isAuthenticated() && request.auth.uid == userId && isValidUser(request.resource.data) && (
        (request.resource.data.role == 'patient' && request.resource.data.get('status', 'approved') == 'approved' && !('licenseVerificationStatus' in request.resource.data && request.resource.data.licenseVerificationStatus != 'pending')) ||
        (request.resource.data.role == 'doctor' && request.resource.data.get('status', 'pending') == 'pending' && request.resource.data.get('licenseVerificationStatus', 'pending') == 'pending') ||
        (isSuperAdmin() && request.resource.data.role == 'admin')
      );
      
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.uid == userId && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOnline', 'lastSeen']) ||
          (isValidUser(request.resource.data) && 
           !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'role', 'status', 'uid', 'email', 'licenseVerificationStatus', 'hospitalApprovalStatus'
           ]))
        ))
      );

      allow delete: if isSuperAdmin();
    }

    // Hospitals: Read is public directory; management strictly admin
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Appointments: Only participant patient, doctor, or superadmin
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId || 
        request.auth.uid == resource.data.doctorId || 
        isSuperAdmin()
      );
      allow create: if isAuthenticated() && 
                    request.auth.uid == request.resource.data.patientId &&
                    request.resource.data.get('status', 'pending') in ['pending', 'scheduled'];
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.patientId && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'updatedAt']) &&
         request.resource.data.status in ['pending', 'cancelled']) ||
        (request.auth.uid == resource.data.doctorId && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doctorNotes', 'meetingLink', 'updatedAt'])) ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    // Medical Records: Strict patient privacy & approved doctor authoring
    match /medicalRecords/{recordId} {
      allow get: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId || 
        request.auth.uid == resource.data.doctorId ||
        (exists(/databases/$(database)/documents/accessRequests/$(resource.data.patientId + "_" + request.auth.uid)) && 
         get(/databases/$(database)/documents/accessRequests/$(resource.data.patientId + "_" + request.auth.uid)).data.status == 'approved') ||
        isSuperAdmin()
      );
      allow list: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId || 
        request.auth.uid == resource.data.doctorId ||
        (exists(/databases/$(database)/documents/accessRequests/$(resource.data.patientId + "_" + request.auth.uid)) && 
         get(/databases/$(database)/documents/accessRequests/$(resource.data.patientId + "_" + request.auth.uid)).data.status == 'approved') ||
        isSuperAdmin()
      );
      allow create: if isDoctor() && request.auth.uid == request.resource.data.doctorId;
      allow update: if isDoctor() && request.auth.uid == resource.data.doctorId;
      allow delete: if isSuperAdmin();
    }

    // Patient Access Requests (Consent Workflow)
    match /accessRequests/{requestId} {
      allow get, list: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId || 
        request.auth.uid == resource.data.doctorId ||
        isSuperAdmin()
      );
      allow create: if isDoctor() && request.resource.data.doctorId == request.auth.uid && request.resource.data.get('status', 'pending') == 'pending';
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.patientId && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'grantedScopes', 'respondedAt', 'signature', 'patientSignature'])) ||
        (request.auth.uid == resource.data.doctorId && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'requestedScopes', 'updatedAt', 'status']) && 
         request.resource.data.status == resource.data.status) ||
        isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId || 
        isSuperAdmin()
      );
    }

    // Clinical Articles & News
    match /articles/{articleId} {
      allow read: if true;
      allow create: if (isDoctor() || isSuperAdmin()) && request.resource.data.authorId == request.auth.uid;
      allow update: if (isSuperAdmin() || (isDoctor() && resource.data.authorId == request.auth.uid)) || 
                    (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments']));
      allow delete: if isSuperAdmin() || (isDoctor() && resource.data.authorId == request.auth.uid);
    }

    // Platform Settings: Admin only
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Notifications: Recipient user or admin
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isSuperAdmin());
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isAuthenticated() && isValidNotification(request.resource.data) && (
        isSuperAdmin() ||
        (request.resource.data.get('senderId', '') == request.auth.uid) ||
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.userId || isSuperAdmin());
    }

    // Direct Messages: Explicit participant authorization
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        (resource.data.get('participants', []) is list && request.auth.uid in resource.data.participants) ||
        resource.data.senderId == request.auth.uid ||
        (resource.data.get('recipientId', '') == request.auth.uid) ||
        (resource.data.roomId.split('_').size() == 2 && (request.auth.uid == resource.data.roomId.split('_')[0] || request.auth.uid == resource.data.roomId.split('_')[1])) ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() && isValidMessage(request.resource.data) && (
        request.resource.data.senderId == request.auth.uid && (
          (request.resource.data.get('participants', []) is list && request.auth.uid in request.resource.data.participants) ||
          (request.resource.data.roomId.split('_').size() == 2 && (request.auth.uid == request.resource.data.roomId.split('_')[0] || request.auth.uid == request.resource.data.roomId.split('_')[1]))
        )
      );
      allow delete: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid || 
        isSuperAdmin()
      );
    }

    // Telehealth Meetings & WebRTC Signaling
    match /meetings/{meetingId} {
      allow read: if isAuthenticated() && (
        (resource.data.get('participants', []) is list && request.auth.uid in resource.data.participants) ||
        resource.data.get('hostId', '') == request.auth.uid ||
        resource.data.get('patientId', '') == request.auth.uid ||
        resource.data.get('doctorId', '') == request.auth.uid ||
        (meetingId.split('_').size() == 2 && (request.auth.uid == meetingId.split('_')[0] || request.auth.uid == meetingId.split('_')[1])) ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() && (
        (request.resource.data.get('participants', []) is list && request.auth.uid in request.resource.data.participants) ||
        request.resource.data.get('hostId', '') == request.auth.uid ||
        request.resource.data.get('doctorId', '') == request.auth.uid ||
        (meetingId.split('_').size() == 2 && (request.auth.uid == meetingId.split('_')[0] || request.auth.uid == meetingId.split('_')[1]))
      );
      allow update: if isAuthenticated() && (
        (resource.data.get('participants', []) is list && request.auth.uid in resource.data.participants) ||
        resource.data.get('hostId', '') == request.auth.uid ||
        (meetingId.split('_').size() == 2 && (request.auth.uid == meetingId.split('_')[0] || request.auth.uid == meetingId.split('_')[1])) ||
        isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.get('hostId', '') == request.auth.uid ||
        isSuperAdmin()
      );
      
      match /offerCandidates/{candidateId} {
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/meetings/$(meetingId)).data.get('participants', []).hasAny([request.auth.uid]) ||
          get(/databases/$(database)/documents/meetings/$(meetingId)).data.get('hostId', '') == request.auth.uid ||
          (meetingId.split('_').size() == 2 && (request.auth.uid == meetingId.split('_')[0] || request.auth.uid == meetingId.split('_')[1]))
        );
      }
      match /answerCandidates/{candidateId} {
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/meetings/$(meetingId)).data.get('participants', []).hasAny([request.auth.uid]) ||
          get(/databases/$(database)/documents/meetings/$(meetingId)).data.get('hostId', '') == request.auth.uid ||
          (meetingId.split('_').size() == 2 && (request.auth.uid == meetingId.split('_')[0] || request.auth.uid == meetingId.split('_')[1]))
        );
      }
    }

    // Direct Video/Audio Calls
    match /calls/{callId} {
      allow read: if isAuthenticated() && (
        resource.data.callerId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid || 
        isSuperAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.callerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.callerId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.callerId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid || 
        isSuperAdmin()
      );
    }

    // Patient Personal Health Reports
    match /healthReports/{reportId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }
  }
}
